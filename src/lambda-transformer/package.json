{
  "name": "lambda-transformer",
  "version": "1.0.0",
  "description": "Stages 8-12: MSK spans -> Gremlin graph upserts (AWS Lambda), the Neptune verification probe, the incident scorer, and the incident alert Lambdas",
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:integration": "jest --config jest.int.config.js --runInBand",
    "build": "npm run build:handler && npm run build:probe && npm run build:scorer && npm run build:alerts",
    "build:handler": "esbuild src/handler.ts --bundle --platform=node --target=node22 --outfile=dist/index.js --external:bufferutil --external:utf-8-validate",
    "build:probe": "esbuild src/probe.ts --bundle --platform=node --target=node22 --outfile=dist/probe.js --external:bufferutil --external:utf-8-validate",
    "build:scorer": "esbuild src/scorer/handler.ts --bundle --platform=node --target=node22 --outfile=dist/scorer.js --external:bufferutil --external:utf-8-validate",
    "build:alerts": "esbuild src/alerts/handler.ts --bundle --platform=node --target=node22 --outfile=dist/alerts.js --external:bufferutil --external:utf-8-validate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/client-dynamodb": "3.1141.0",
    "@aws-sdk/client-sagemaker-runtime": "3.1141.0",
    "@aws-sdk/client-sns": "3.1141.0",
    "@aws-sdk/client-ssm": "3.1141.0",
    "@aws-sdk/lib-dynamodb": "3.1141.0",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.4",
    "gremlin": "3.7.3"
  }
}
