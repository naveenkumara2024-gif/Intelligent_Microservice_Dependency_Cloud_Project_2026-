{
  "name": "infra-cdk",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "preflight": "tsx scripts/preflight.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "deploy:vpc": "npm run preflight && cdk deploy VpcStack && npm run verify:vpc",
    "verify:vpc": "tsx scripts/verify-vpc.ts",
    "destroy:vpc": "tsx scripts/pre-destroy.ts && cdk destroy VpcStack",
    "deploy:eks": "npm run preflight && cdk deploy EksStack",
    "deploy:workloads": "tsx scripts/deploy-workloads.ts",
    "verify:eks": "tsx scripts/verify-eks.ts",
    "destroy:eks": "tsx scripts/pre-destroy.ts && cdk destroy EksStack"
  },
  "devDependencies": {
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "jest": "^30",
    "aws-cdk": "2.1142.0",
    "tsx": "^4.23.0",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.269.0",
    "constructs": "^10.5.0"
  }
}
